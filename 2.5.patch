diff --git a/commons-email2-jakarta/src/test/java/org/apache/commons/mail2/jakarta/activation/PathDataSourceTest.java b/commons-email2-jakarta/src/test/java/org/apache/commons/mail2/jakarta/activation/PathDataSourceTest.java
