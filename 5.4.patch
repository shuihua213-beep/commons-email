+      <plugin>
+        <groupId>org.apache.maven.plugins</groupId>
+        <artifactId>maven-enforcer-plugin</artifactId>
+        <version>3.5.0</version>
+        <executions>
+          <execution>
+            <id>enforce-dependency-version-consistency</id>
+            <goals>
+              <goal>enforce</goal>
+            </goals>
+            <phase>validate</phase>
+            <configuration>
+              <rules>
+                <dependencyConvergence/>
+                <evaluateBeanshell>
+                  <condition>
+                    import org.apache.maven.project.MavenProject;
+                    import org.apache.maven.model.Dependency;
+
+                    java.util.Map projectsMap = new java.util.HashMap();
+                    java.util.List allProjects = session.getAllProjects();
+                    for (int i = 0; i &lt; allProjects.size(); i++) {
+                        MavenProject p = (MavenProject) allProjects.get(i);
+                        projectsMap.put(p.getArtifactId(), p);
+                    }
+
+                    MavenProject jakarta = (MavenProject) projectsMap.get("commons-email2-jakarta");
+                    MavenProject javax = (MavenProject) projectsMap.get("commons-email2-javax");
+
+                    if (jakarta == null || javax == null) {
+                        return true;
+                    }
+
+                    java.util.List jakartaDeps = jakarta.getDependencies();
+                    java.util.List javaxDeps = javax.getDependencies();
+
+                    java.util.Map jakartaDepMap = new java.util.HashMap();
+                    for (int i = 0; i &lt; jakartaDeps.size(); i++) {
+                        Dependency d = (Dependency) jakartaDeps.get(i);
+                        String key = d.getGroupId() + ":" + d.getArtifactId();
+                        jakartaDepMap.put(key, d.getVersion());
+                    }
+
+                    java.util.Map javaxDepMap = new java.util.HashMap();
+                    for (int i = 0; i &lt; javaxDeps.size(); i++) {
+                        Dependency d = (Dependency) javaxDeps.get(i);
+                        String key = d.getGroupId() + ":" + d.getArtifactId();
+                        javaxDepMap.put(key, d.getVersion());
+                    }
+
+                    boolean consistent = true;
+                    java.util.Set jakartaKeys = jakartaDepMap.keySet();
+                    java.util.Iterator iter = jakartaKeys.iterator();
+                    while (iter.hasNext()) {
+                        String key = (String) iter.next();
+                        if (javaxDepMap.containsKey(key)) {
+                            String jakartaVer = (String) jakartaDepMap.get(key);
+                            String javaxVer = (String) javaxDepMap.get(key);
+                            if (jakartaVer != null && javaxVer != null && !jakartaVer.equals(javaxVer)) {
+                                log.error("Version mismatch for " + key + ": Jakarta=" + jakartaVer + " vs Javax=" + javaxVer);
+                                consistent = false;
+                            }
+                        }
+                    }
+
+                    if (!consistent) {
+                        throw new Exception("Dependency version mismatch between Jakarta and Javax modules! Build failed.");
+                    }
+
+                    return true;
+                  </condition>
+                </evaluateBeanshell>
+              </rules>
+            </configuration>
+          </execution>
+        </executions>
